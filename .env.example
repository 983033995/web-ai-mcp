# DeepSeek Web. Required only when enabling DeepSeek; optional for other providers.
# Never commit live credentials.
DEEPSEEK_USER_TOKEN=
DEEPSEEK_WEB_BASE_URL=https://chat.deepseek.com/api/v0
DEEPSEEK_TIMEOUT=60000
# Optional default for chat/file tools. Explicit thinking overrides it;
# deepseek_reasoner always enables thinking. Exact values: true or false.
# DEEPSEEK_DEFAULT_THINKING=false

# Doubao Web (v0.2.0+). Get all three required values from ONE successful own-account
# POST /chat/completion in browser DevTools > Network > Headers; see README.
# Full Cookie value, without the "Cookie:" field name.
# Must include sessionid (or sessionid_ss), CSRF token and s_v_web_id.
DOUBAO_COOKIE=
# Full POST /chat/completion URL copied locally from your own Network panel.
DOUBAO_CHAT_URL=
# User-Agent from the same request. Never share Cookie or signed request URLs.
DOUBAO_USER_AGENT=
# Optional milliseconds; actual default is 60000, 120000 is recommended for generation.
DOUBAO_TIMEOUT=120000
# Optional startup defaults; explicit tool arguments take priority.
# DOUBAO_DEFAULT_MODE=quick
# DOUBAO_DEFAULT_IMAGE_MODEL=Seedream 5.0 Flash
# DOUBAO_DEFAULT_VIDEO_MODEL=Seedance 2.0 Fast
# Gemini Web (experimental source integration). From your own normal browser session.
# Full Cookie header without the "Cookie:" name; must include __Secure-1PSID.
# __Secure-1PSIDTS is needed when present on your account. Never share these values.
GEMINI_COOKIE=
# Normal User-Agent from the same browser session; no browser impersonation.
GEMINI_USER_AGENT=
# Entire operation, including init and streamed reply. Milliseconds.
GEMINI_TIMEOUT=60000
# Optional startup selections. Model values must exactly match gemini_models.
# Priority: explicit argument > saved session choice > capability model default
# > general model default > website route. Thinking falls back to Low.
# GEMINI_DEFAULT_MODEL=3.1 Pro
# GEMINI_DEFAULT_THINKING_LEVEL=high
# GEMINI_DEFAULT_IMAGE_MODEL=3.1 Pro
# GEMINI_DEFAULT_VIDEO_MODEL=Flash-Lite
# Multi-account alternative: absolute path to a private JSON file (0600).
# Do not set GEMINI_COOKIE/GEMINI_USER_AGENT together with this file.
# GEMINI_ACCOUNTS_FILE=/absolute/private/path/gemini-accounts.json
# Optional shared private cooldown store; defaults beside sessions.json.
# GEMINI_COOLDOWN_STORE_PATH=/absolute/private/path/gemini-cooldowns.json
# Accounts are considered in file order. Only definitive generation quota
# rejection advances to the next account; active conversations stay pinned.
# Per-account cooldownMinutes.image/video is a configured backoff, not a
# claimed website reset time. Without a known reset or backoff, it stays blocked.
# No automatic Cookie rotation; update expired credentials manually.
# If a proxy is required, use Node 24+ and explicitly configure the process:
# NODE_USE_ENV_PROXY=1
# HTTPS_PROXY=http://127.0.0.1:your-local-proxy-port
# System proxy settings alone are not inherited by Node fetch.
# For background long chat use 600000 for DOUBAO_TIMEOUT and DEEPSEEK_TIMEOUT.
# A longer website timeout alone does not change the MCP client control timeout.
# Optional; absolute roots separated by ":" on macOS/Linux or ";" on Windows.
# If empty/unset, file uploads are blocked.
WEB_AI_ALLOWED_ROOTS=
# Optional completed-media download directory. Create it first; absolute, no symlinks.
# Empty/unset blocks media downloads. Independent from upload authorization.
WEB_AI_MEDIA_DIR=
# 0 (default) disables local expiry; a positive value sets idle TTL in minutes.
WEB_AI_SESSION_TTL_MINUTES=0
# Pin a project root when the MCP client launches outside your project.
# WEB_AI_PROJECT_ROOT=/absolute/path/to/project
# Optional explicit private lineage store; defaults to <project>/.web-ai-mcp/sessions.json.
# WEB_AI_SESSION_STORE_PATH=/absolute/path/to/sessions.json
# Optional offline PoW WASM at the pinned SHA-256 (not bundled in npm).
# WEB_AI_WASM_PATH=/absolute/path/to/sha3_wasm_bg.wasm
